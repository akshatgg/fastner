# Deployment environment: "development" (or "dev"/"local") vs "production".
# In development, AUTO_VERIFY_EMAIL defaults to true so signup works without
# Postmark. Anything else (or unset) = production → email verification required.
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:postgres@localhost:54323/fastner_db

# JWT / auth
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Symmetric encryption key for reversible token encryption (Fernet)
CRYPTOGRAPHY_SECRET=dev-crypto-secret-change-me

# Email verification (optional override of the ENVIRONMENT-driven default above)
# true  -> new accounts are auto-verified, NO email sent, signup logs in immediately
# false -> new accounts must verify via a Postmark email before they can sign in
# Leave UNSET to follow ENVIRONMENT (dev=true, prod=false). Only set this to
# force a specific behavior regardless of environment.
# AUTO_VERIFY_EMAIL=
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Postmark (only required when AUTO_VERIFY_EMAIL=false)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_FROM=no-reply@ibcfasteners.com

# Used to build the verification link inside emails
FRONTEND_BASE_URL=http://localhost:3000
