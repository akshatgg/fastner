# Deployment environment: "development" (or "dev"/"local") vs "production".
# In development, AUTO_VERIFY_EMAIL defaults to true so signup works without
# Postmark. Anything else (or unset) = production → email verification required.
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:postgres@localhost:54323/fastner_db

# JWT / auth
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Symmetric encryption key for reversible token encryption (Fernet)
CRYPTOGRAPHY_SECRET=dev-crypto-secret-change-me

# Email verification (optional override of the ENVIRONMENT-driven default above)
# true  -> new accounts are auto-verified, NO email sent, signup logs in immediately
# false -> new accounts must verify via a Postmark email before they can sign in
# Leave UNSET to follow ENVIRONMENT (dev=true, prod=false). Only set this to
# force a specific behavior regardless of environment.
# AUTO_VERIFY_EMAIL=
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Master email kill-switch. false → NO outbound email is sent anywhere (every
# send short-circuits), regardless of POSTMARK_SERVER_TOKEN. Defaults to true.
EMAIL_ENABLED=true

# Postmark (only required when AUTO_VERIFY_EMAIL=false)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_FROM=sales@indbolt.com

# Used to build the verification link inside emails
FRONTEND_BASE_URL=http://localhost:3000

# Cloudinary (server-side; only for signed ops like image deletion).
# Cloud name matches the frontend's NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME.
# API key/secret are SECRET — never expose to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay payments (optional). Leave BOTH blank to place orders WITHOUT payment
# (the current behaviour — checkout just confirms the order). To enable online
# payment, set the TEST keys here on dev and the LIVE keys in production — that
# env difference is the only switch. KEY_ID is publishable (the frontend reads it
# from /payments/config); KEY_SECRET is server-only and must never reach the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Sign-In (optional). The Web OAuth 2.0 Client ID from the Google Cloud
# Console (APIs & Services → Credentials). Add http://localhost:3000 to the
# client's "Authorized JavaScript origins". Same value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
